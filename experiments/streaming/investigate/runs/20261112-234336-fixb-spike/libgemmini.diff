+void gemmini_t::load_idx(reg_t dram_addr, reg_t sp_addr) {
+#ifdef NM_DENSE_BUILD
+  nm_loop_abort("LOAD_IDX (funct 27) on a dense build (nm_sparsity = None)"); // N11
+#endif
+  const reg_t base_row_addr = sp_addr & 0xFFFFFFFF;
+  const reg_t cols = (sp_addr >> addr_len) & 0xFFFF;
+  const reg_t rows = (sp_addr >> (addr_len + 16)) & 0xFFFF;
+  if (cols != 16 || rows == 0 || rows > 16)
+    nm_loop_abort("LOAD_IDX needs cols == 16 and 1..16 rows"); // N12
+  if (base_row_addr + rows > (reg_t)BANK_NUM * BANK_ROWS) // also catches accumulator addresses and GARBAGE
+    nm_loop_abort("LOAD_IDX destination must be a scratchpad row address"); // N13
+
+  dprintf("GEMMINI: load_idx - 0x%02lx rows from 0x%08lx to addr 0x%08lx\n", rows, dram_addr, base_row_addr);
+
+  for (size_t row = 0; row < rows; ++row) {
+    for (size_t col = 0; col < cols; ++col) {
+      // a NULL DRAM address loads zeros, like every mvin
+      gemmini_state.spad.at(base_row_addr + row).at(col) =
+        dram_addr == 0 ? 0 : read_from_dram<elem_t>(dram_addr + row*16 + col*sizeof(elem_t));
+    }
+  }
+}
